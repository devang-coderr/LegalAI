# Base URL of the backend API. All frontend requests go through this — never hardcode URLs in components.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# When "true" (default), services/*.api.ts return mock/demo data instead of calling the backend.
# Set to "false" once the backend team's endpoints are live.
NEXT_PUBLIC_USE_MOCKS=true
