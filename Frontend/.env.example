# LegalAI Frontend Environment Configuration
# Copy this file to .env.local for local development.

# URL of the running FastAPI backend (default: http://localhost:8000/api/v1 or http://localhost:8081/api/v1)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Set to true only if you wish to run the frontend with mock data in development
NEXT_PUBLIC_USE_MOCKS=false
