# Copy this file to .env and fill in real values.
# Never commit .env -- it's already in .gitignore below.

# Format: mysql+asyncmy://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=mysql+asyncmy://legalai_user:CHANGE_ME@127.0.0.1:3306/legalai_db

# Generate a real one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=CHANGE_ME

# Qdrant Cloud: paste your cluster URL + API key from the Qdrant Cloud dashboard.
# Local Docker instead: QDRANT_URL=http://localhost:6333 and leave the API key blank.
QDRANT_URL=https://YOUR-CLUSTER-URL.qdrant.io
QDRANT_API_KEY=CHANGE_ME

# Comma-separated if you ever need more than one origin.
CORS_ORIGINS=http://localhost:3000

LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-3.6-flash
MAX_UPLOAD_SIZE_MB=15
ALLOWED_UPLOAD_TYPES=application/pdf,image/png,image/jpeg